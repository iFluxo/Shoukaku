{
	"name": "@ifluxo/shoukaku",
	"version": "5.0.0-dev.0",
	"description": "A stable and updated wrapper around Lavalink",
	"keywords": [
		"api",
		"bot",
		"discord",
		"discord.js",
		"lavalink",
		"lavalink-api",
		"lavalink.js",
		"music",
		"weeb-library"
	],
	"license": "MIT",
	"author": "Saya",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shipgirlproject/Shoukaku.git"
	},
	"directories": {
		"lib": "src"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run build:check && bun run build:js && bun run build:types",
		"build:check": "tsc --noEmit",
		"build:docs": "typedoc",
		"build:js": "bun build src/index.ts --outdir dist --target bun --format esm --minify --sourcemap=external",
		"build:types": "tsc --project tsconfig.build.json",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check",
		"lint": "oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json --type-aware --type-check .",
		"lint:fix": "oxfmt . && oxlint --tsconfig=tsconfig.eslint.json --type-aware --type-check . --fix --fix-suggestions",
		"prepack": "bun run build",
		"prepare": "lefthook install",
		"test": "bun test --pass-with-no-tests"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"eslint-config-neon": "^0.5.4",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.53.0",
		"oxlint": "1.83.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typedoc": "^0.28.20",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.4"
}
